# Database Configuration
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration (min. 32 caractères aléatoires — jamais un placeholder en production)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
# Session longue si « Se souvenir de moi »
JWT_EXPIRES_REMEMBER=7d

# Cookie HttpOnly — Netlify (www.synaptasys.com) → Render = cross-site
AUTH_COOKIE_CROSS_SITE=true
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true

# CORS (synaptasys / hotel déjà inclus par défaut dans le code ; complète si besoin)
CORS_ORIGINS=https://www.synaptasys.com,https://synaptasys.com,https://hotelbeatricesys.com,https://www.hotelbeatricesys.com

# Server Configuration
PORT=5002
NODE_ENV=production

# URL front (liens email reset / bienvenue) — doit être dans CORS_ORIGINS
FRONTEND_URL=http://localhost:3000

# CORS — origines front autorisées (séparées par des virgules). Sur Render : éditez cette seule variable.
CORS_ORIGINS=https://hotelbeatricesys.com,https://www.hotelbeatricesys.com,https://synaptasys.com,https://www.synaptasys.com,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# true = autorise aussi https://*.onrender.com (préviews / fronts Render)
CORS_ALLOW_ONRENDER=false

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Configuration Firebase pour les notifications push
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
